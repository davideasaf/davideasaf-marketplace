#!/usr/bin/env python3
"""Controller-owned Codex executable shim for isolated Ask workers."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time


def fail(message: str) -> "NoReturn":
    print(f"fable-orchestrator codex shim: {message}", file=sys.stderr)
    raise SystemExit(126)


real_value = os.environ.get("FABLE_ORCHESTRATOR_REAL_CODEX", "")
real = Path(real_value).expanduser().resolve() if real_value else None
if real is None or not real.is_file() or not os.access(real, os.X_OK):
    fail("FABLE_ORCHESTRATOR_REAL_CODEX is not an executable file")
if len(sys.argv) < 2 or sys.argv[1] != "exec":
    fail("only `codex exec` is permitted")
if "--ignore-user-config" in sys.argv[2:]:
    fail("caller must not pre-inject --ignore-user-config")

probe = subprocess.run(
    [str(real), "exec", "--help"],
    text=True,
    capture_output=True,
    timeout=10,
    check=False,
)
if probe.returncode != 0 or "--ignore-user-config" not in probe.stdout:
    fail("real CLI does not support `codex exec --ignore-user-config`")

command = [str(real), "exec", "--ignore-user-config", *sys.argv[2:]]
output_path: Path | None = None
for index, argument in enumerate(command[:-1]):
    if argument in {"-o", "--output-last-message"}:
        output_path = Path(command[index + 1]).expanduser()
        break
if output_path is None:
    fail("Ask wrapper command has no output-last-message path for provenance")

run = output_path.parent
run.mkdir(mode=0o700, parents=True, exist_ok=True)
run.chmod(0o700)
try:
    isolation = json.loads(os.environ["FABLE_ORCHESTRATOR_ISOLATION_JSON"])
except (KeyError, json.JSONDecodeError) as exc:
    fail(f"isolation contract is unavailable: {exc}")
if (
    not isinstance(isolation, dict)
    or isolation.get("ignore_user_config") is not True
    or isolation.get("external_capabilities") != []
    or Path(str(isolation.get("real_codex", ""))).resolve() != real
):
    fail("isolation contract does not match the executable boundary")

(run / "cmd.txt").write_text(shlex.join(command) + "\n", encoding="utf-8")
(run / "isolation.json").write_text(
    json.dumps(isolation, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
for artifact in (run / "cmd.txt", run / "isolation.json"):
    artifact.chmod(0o600)


def write_supervision(value: dict) -> None:
    target = run / "supervision.json"
    temporary = run / f".supervision.{os.getpid()}.tmp"
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.chmod(0o600)
    os.replace(temporary, target)
    target.chmod(0o600)
    directory = os.open(run, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


watchdog_value = os.environ.get("FABLE_ORCHESTRATOR_WATCHDOG", "")
wrapper_value = os.environ.get("FABLE_ORCHESTRATOR_ASK_CODEX", "")
try:
    timeout_s = float(os.environ["FABLE_ORCHESTRATOR_WATCHDOG_TIMEOUT_S"])
    grace_s = float(os.environ.get("FABLE_ORCHESTRATOR_WATCHDOG_GRACE_S", "1"))
except (KeyError, ValueError) as exc:
    fail(f"watchdog timing contract is invalid: {exc}")
watchdog = Path(watchdog_value).expanduser().resolve() if watchdog_value else None
wrapper = Path(wrapper_value).expanduser().resolve() if wrapper_value else None
if watchdog is None or not watchdog.is_file() or not os.access(watchdog, os.X_OK):
    fail("controller watchdog is unavailable")
if wrapper is None or not wrapper.is_file() or not os.access(wrapper, os.X_OK):
    fail("installed Ask wrapper is unavailable for watchdog state/cancel")
if timeout_s <= 0 or grace_s <= 0:
    fail("watchdog timeout and grace must be positive")

try:
    os.setsid()
except OSError as exc:
    fail(f"could not create the controller-owned worker session: {exc}")
target_pid = os.getpid()
target_pgid = os.getpgrp()
if target_pid != target_pgid:
    fail("setsid did not establish a PID-matched process group")
supervision = {
    "mode": "setsid_process_group",
    "identity_ready": True,
    "watchdog_started": False,
    "target_pid": target_pid,
    "target_pgid": target_pgid,
    "run_id": run.name,
    "real_codex": str(real),
    "codex_shim": str(Path(__file__).resolve()),
    "codex_shim_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
    "timeout_s": timeout_s,
    "grace_s": grace_s,
    "deadline_epoch": time.time() + timeout_s,
    "recorded_before_exec": True,
}
write_supervision(supervision)
watchdog_command = [
    str(watchdog),
    "--wrapper",
    str(wrapper),
    "--run-id",
    run.name,
    "--run-dir",
    str(run),
    "--supervision",
    str(run / "supervision.json"),
]
try:
    watcher = subprocess.Popen(
        watchdog_command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
        env=dict(os.environ),
    )
except OSError as exc:
    fail(f"could not start the pre-exec watchdog: {exc}")
supervision["watchdog_pid"] = watcher.pid
supervision["watchdog_started"] = True
write_supervision(supervision)

os.execv(str(real), command)
